enum Status {
  DONE
  TODO
}

type Transaction {
  id: ID!
  amount: Float!
  date: String!
  description: String
  account: String!
}

type ComputedTransaction {
  id: ID!
  amount: Float!
  date: String!
  description: String
  balance: Float!
  status: Status!
  account: String!
}

input ListTransactionsInput {
  from: String!
  to: String!
  account: String!
}

input NewTransactionInput {
  date: String!
  amount: Float!
  recurrency: String
  description: String
  account: String!
}

enum TransactionEditType {
  ALL
  ON_DATE_ONLY
  FROM_DATE
}

input TransactionEditInput {
  id: ID!
  type: TransactionEditType!
  date: String
  amount: Float
  description: String
  recurrency: String
  account: String!
}

input DeleteTransactionInput {
  id: ID!
  account: String!
}

input DeleteRecurringTransactionInput {
  id: ID!
  account: String!
  date: String!
}

extend type Query {
  listTransactions(input: ListTransactionsInput!): [ComputedTransaction!]!
    @auth(requires: authenticated)
}

extend type Mutation {
  createTransaction(input: NewTransactionInput!): String!
    @auth(requires: authenticated)
  createTransactions(input: [NewTransactionInput!]!): [String!]!
    @auth(requires: authenticated)

  deleteTransaction(input: DeleteTransactionInput!): ID!
    @auth(requires: authenticated)
  deleteTransactions(input: [DeleteTransactionInput!]!): [ID!]!
    @auth(requires: authenticated)
  deleteRecurringTransaction(input: DeleteRecurringTransactionInput!): String!
    @auth(requires: authenticated)

  editTransaction(input: TransactionEditInput!): ID!
    @auth(requires: authenticated)
}
