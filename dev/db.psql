/*
drop table cashflow.accounts;
drop table cashflow.balances;
drop table cashflow.transactions;
drop table cashflow.plans;
*/

/*
create table
  cashflow.accounts (
    created_at timestamp with time zone not null default now(),
    author uuid not null default auth.uid(),
    name text not null default ''::text,
    constraint pk_accounts primary key (name, author),
    constraint unique_name_id unique (name, author),
    constraint accounts_author_fkey foreign key (author) references auth.users (id) on delete cascade
);


create table
  cashflow.balances (
    amount numeric(10, 2) not null,
    date date not null,
    author uuid not null default auth.uid(),
    account text not null,
    constraint balances_pkey primary key (date, author, account),
    constraint unique_date_author unique (date, author),
    constraint balances_account_author_fkey foreign key (account, author) references cashflow.accounts (name, author) on update cascade on delete cascade,
    constraint balances_author_fkey foreign key (author) references auth.users (id) on delete cascade
);

create table
  cashflow.transactions (
    id integer generated by default as identity not null,
    description text not null,
    amount numeric(10, 2) not null,
    date date not null,
    recurrency text not null default ''::text,
    author uuid not null default auth.uid(),
    account text not null,
    constraint transactions_pkey primary key (id),
    constraint transactions_account_author_fkey foreign key (account, author) references cashflow.accounts (name, author) on update cascade on delete cascade,
    constraint transactions_author_fkey foreign key (author) references auth.users (id) on delete cascade
);


create table
  cashflow.plans (
    id integer generated by default as identity not null,
    created_at timestamp with time zone not null default now(),
    author uuid not null default auth.uid(),
    name text not null,
    start_date date not null,
    recurrency text not null default ''::text,
    from_account text null,
    to_account text not null,
    total_amount numeric not null,
    constraint plans_pkey primary key (id),
    constraint plans_to_account_author_fkey foreign key (to_account, author) references cashflow.accounts (name, author) on update cascade on delete cascade,
    constraint plans_author_fkey foreign key (author) references auth.users (id) on delete cascade
);
*/

/*
ALTER TABLE cashflow.accounts ENABLE ROW LEVEL SECURITY;
ALTER TABLE cashflow.balances ENABLE ROW LEVEL SECURITY;
ALTER TABLE cashflow.transactions ENABLE ROW LEVEL SECURITY;
ALTER TABLE cashflow.plans ENABLE ROW LEVEL SECURITY;
*/

